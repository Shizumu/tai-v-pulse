# 複製本檔為 .env，再填入自己的 YouTube Data API v3 Key。
# 可直接修改下一行；若不小心新增多行，程式會採用最後一個同名設定。
YOUTUBE_API_KEY=

# 對外分享版本固定使用 public；作者自己的本機 .env 可使用 personal。
TAI_V_PULSE_EDITION=public
NEXT_PUBLIC_TAI_V_PULSE_EDITION=public

# 本機服務
TRACKER_API_PORT=8787
DATABASE_PATH=work/tai_v_pulse.sqlite3

# 收錄與擷取規則
MIN_SUBSCRIBERS=1000
LIVE_POLL_SECONDS=60
CHANNEL_REFRESH_HOURS=6
UPLOAD_SCAN_HOURS=4
DISCOVERY_PAGES_PER_TERM=2

# 對外發布版可用值：7、14、30。
RETENTION_DAYS=30

# 僅適用於自己匯入的 Studio 報表及手動補充資料。
# 可用值：30、180、365、730、1095、1825、3650、0；0 代表不自動清除。
CREATOR_RETENTION_DAYS=0

# 2026 年一般預設配額；以 Google Cloud Console 顯示為準。
QUOTA_GENERAL_LIMIT=10000
QUOTA_SEARCH_LIMIT=100
QUOTA_SAFETY_PERCENT=10

# 前端預設已連到這個位置，通常不必修改。
NEXT_PUBLIC_TRACKER_API=http://127.0.0.1:8787
